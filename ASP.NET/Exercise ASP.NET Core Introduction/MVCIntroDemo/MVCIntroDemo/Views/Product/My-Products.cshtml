@model IEnumerable<MVCIntroDemo.Models.Product.ProductViewModel>

@{
	ViewBag.Title = "All Products";
}
<div class="row">
	<div class="col-2">
		<div class="card">
			<div class="card-header">@ViewBag.Title</div>
			<ul class="list-group list-group-flush">
				@foreach (var product in Model)
				{
					<li class="list-group-item">
						<a asp-action="ById" asp-route-Id="@product.Id" class="btn btn-outline-primary">N. @product.Id: @product.Name - @product.Price lv.</a>
					</li>
				}		
			</ul>
		</div>
	</div>
</div>
